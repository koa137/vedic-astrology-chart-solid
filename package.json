{
  "name": "vedic-astrology-chart-solid",
  "version": "2.0.10",
  "type": "module",
  "description": "Beautiful Vedic (Jyotish) astrology chart component for SolidJS",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./src/styles/vedic-chart.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koa137/vedic-astrology-chart-solid.git"
  },
  "bugs": {
    "url": "https://github.com/koa137/vedic-astrology-chart-solid/issues"
  },
  "homepage": "https://github.com/koa137/vedic-astrology-chart-solid#readme",
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc --project tsconfig.build.json",
    "dev": "vite",
    "dev:demo": "vite --config vite.demo.config.js",
    "test": "vitest",
    "lint": "eslint src/**/*.{ts,tsx} --max-warnings 0",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build"
  },
  "keywords": [
    "vedic",
    "astrology",
    "jyotish",
    "chart",
    "horoscope",
    "solidjs",
    "solid-js",
    "svg",
    "nakshatras",
    "rashi",
    "navamsa",
    "hindu-astrology",
    "sidereal",
    "typescript"
  ],
  "author": "koa137",
  "license": "MIT",
  "peerDependencies": {
    "solid-js": "^2.0.0",
    "@solidjs/web": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.3",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-solid": "^0.14.0",
    "prettier": "^3.0.0",
    "solid-js": "^2.0.3",
    "typescript": "^5.0.0",
    "vite": "^8.3.8"
  }
}
