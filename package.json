{
  "name": "vedic-astrology-chart-solid",
  "version": "0.1.0",
  "type": "module",
  "description": "Beautiful Vedic (Jyotish) astrology chart component for Solid JS",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/koa137/vedic-astrology-chart-solid.git"
  },
  "bugs": {
    "url": "https://github.com/koa137/vedic-astrology-chart-solid/issues"
  },
  "homepage": "https://github.com/koa137/vedic-astrology-chart-solid#readme",
  "scripts": {
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "vite",
    "dev:demo": "vite --config vite.demo.config.js",
    "test": "vitest",
    "lint": "eslint src/**/*.{ts,tsx} --max-warnings 0",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build"
  },
  "keywords": [
    "vedic",
    "astrology",
    "jyotish",
    "chart",
    "horoscope",
    "solidjs",
    "svg",
    "nakshatras",
    "rashi",
    "navamsa",
    "hindu-astrology"
  ],
  "author": "Matthew Jones",
  "license": "MIT",
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-solid": "^0.14.0",
    "prettier": "^3.0.0",
    "solid-js": "^1.9.9",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.11.8"
  }
}
